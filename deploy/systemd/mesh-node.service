[Unit]
Description=Analytics Mesh node
Documentation=file:///opt/analytics-mesh/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User=/Group= are placeholders. Create this account or change both to the
# user that owns WorkingDirectory, connector data dirs, and /etc/analytics-mesh.
User=mesh
Group=mesh
WorkingDirectory=/opt/analytics-mesh
# Copy deploy/systemd/mesh.env.example → /etc/analytics-mesh/mesh.env (chmod 600).
# Leading '-' means the file is optional (laptop copies can omit it).
EnvironmentFile=-/etc/analytics-mesh/mesh.env
Environment=MESH_NODE_CONFIG=/etc/analytics-mesh/node.yaml
# Default listen is 127.0.0.1 in YAML/code. Optional MESH_LISTEN_HOST in mesh.env
# (or listen_host in the YAML). Do not bind 0.0.0.0.
# Shipped entrypoints: mesh-node, python -m mesh_node, or `uv run mesh serve -c ...`
ExecStart=/usr/bin/uv run --directory /opt/analytics-mesh mesh-node
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
