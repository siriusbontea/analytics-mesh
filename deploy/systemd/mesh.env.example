# Copy to /etc/analytics-mesh/mesh.env and chmod 600. Do not commit this file.
#
# Pairing token — REQUIRED beyond localhost. Example YAML keeps demo-pair-token
# only for laptop demos. MESH_PAIR_TOKEN overrides YAML on plane and node.
# MESH_PAIR_TOKEN=replace-me-before-any-non-localhost-use

# Optional listen override (default 127.0.0.1). Use a Tailscale or LAN address
# for multi-machine. Do not set 0.0.0.0 unless you know the NIC is private.
# MESH_LISTEN_HOST=100.64.0.12
# MESH_LISTEN_PORT=8080

# Optional models (never put keys in YAML; see configs/examples/models.yaml)
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# MCP / Postgres
# MESH_URL=http://127.0.0.1:8080
# MESH_PRINCIPAL=local
# MESH_POSTGRES_DSN=
