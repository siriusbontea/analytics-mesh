[Unit]
Description=Analytics Mesh control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mesh
Group=mesh
WorkingDirectory=/opt/analytics-mesh
Environment=MESH_PLANE_CONFIG=/etc/analytics-mesh/plane.yaml
Environment=MESH_LISTEN_HOST=127.0.0.1
ExecStart=/usr/bin/uv run --directory /opt/analytics-mesh mesh-plane
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
