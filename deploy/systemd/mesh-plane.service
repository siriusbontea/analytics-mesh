[Unit]
Description=Analytics Mesh control plane
Documentation=file:///opt/analytics-mesh/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User=/Group= are placeholders. Create this account or change both to the
# user that owns WorkingDirectory and /etc/analytics-mesh.
User=mesh
Group=mesh
WorkingDirectory=/opt/analytics-mesh
# Copy deploy/systemd/mesh.env.example → /etc/analytics-mesh/mesh.env (chmod 600).
# Set MESH_PAIR_TOKEN there — do not commit a real registration token.
EnvironmentFile=-/etc/analytics-mesh/mesh.env
Environment=MESH_PLANE_CONFIG=/etc/analytics-mesh/plane.yaml
# Default listen is 127.0.0.1 in YAML/code. Optional MESH_LISTEN_HOST in mesh.env
# (or listen_host in the YAML). Do not bind 0.0.0.0.
# Shipped entrypoints: mesh-plane, python -m mesh_plane, or `uv run mesh plane -c ...`
ExecStart=/usr/bin/uv run --directory /opt/analytics-mesh mesh-plane
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
